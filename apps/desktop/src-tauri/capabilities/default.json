{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Least-privilege permissions for the Rackio desktop window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
