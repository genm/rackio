{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rackio",
  "version": "0.1.0",
  "identifier": "dev.rackio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rackio",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../../LICENSE-APACHE",
      "../../../LICENSE-MIT",
      "../../../THIRDPARTY-JAVASCRIPT.html",
      "../../../THIRDPARTY.html"
    ]
  }
}
