[Unit]
Description=Tray Monitor P2P metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tray-monitor
Group=tray-monitor-viewers
ExecStart=/usr/local/bin/tray-monitor daemon
Restart=on-failure
RestartSec=5s
UMask=0007
ConfigurationDirectory=tray-monitor
ConfigurationDirectoryMode=0750
StateDirectory=tray-monitor
StateDirectoryMode=0750
LogsDirectory=tray-monitor
LogsDirectoryMode=0750
RuntimeDirectory=tray-monitor
RuntimeDirectoryMode=0770
Environment=TRAY_MONITOR_CONFIG_DIR=/etc/tray-monitor
Environment=TRAY_MONITOR_DATA_DIR=/var/lib/tray-monitor
Environment=TRAY_MONITOR_STATE_DIR=/var/log/tray-monitor
Environment=TRAY_MONITOR_SOCKET=/run/tray-monitor/agent.sock
Environment=TRAY_MONITOR_SHARED_SOCKET=1
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/etc/tray-monitor /var/lib/tray-monitor /var/log/tray-monitor /run/tray-monitor
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
