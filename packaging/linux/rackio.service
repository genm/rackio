[Unit]
Description=Rackio P2P metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rackio
Group=rackio-viewers
ExecStart=/usr/local/bin/rackio daemon
Restart=on-failure
RestartSec=5s
UMask=0077
ConfigurationDirectory=rackio
ConfigurationDirectoryMode=0700
StateDirectory=rackio
StateDirectoryMode=0700
LogsDirectory=rackio
LogsDirectoryMode=0700
RuntimeDirectory=rackio
# 0750, not 0770: the viewer group needs to traverse this directory and open
# the 0660 socket inside it, never to write the directory itself. Write
# permission on a directory is what allows unlinking and re-creating entries in
# it, so a group-writable runtime directory would let any viewer replace the
# daemon's socket with their own and answer for it.
RuntimeDirectoryMode=0750
Environment=RACKIO_CONFIG_DIR=/etc/rackio
Environment=RACKIO_DATA_DIR=/var/lib/rackio
Environment=RACKIO_STATE_DIR=/var/lib/rackio/state
Environment=RACKIO_LOG_DIR=/var/log/rackio
Environment=RACKIO_SOCKET=/run/rackio/agent.sock
Environment=RACKIO_SHARED_SOCKET=1
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/etc/rackio /var/lib/rackio /var/log/rackio /run/rackio
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
